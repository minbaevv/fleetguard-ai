# Скопируйте в .env и заполните значения. .env в git не попадает.
ENVIRONMENT=development
DEBUG=false

# PostgreSQL (docker compose публикует 5433 на хосте)
POSTGRES_USER=fleetguard
POSTGRES_PASSWORD=
POSTGRES_DB=fleetguard
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://fleetguard:@localhost:5433/fleetguard

REDIS_URL=redis://localhost:6379/0

# MinIO / S3
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT_URL=http://localhost:9000
# Необязательно: адрес MinIO/S3 для браузера, если backend ходит по внутреннему адресу
S3_PUBLIC_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=fleetguard
S3_REGION=us-east-1
S3_USE_SSL=false
# Срок жизни подписанной ссылки на фото: от 60 секунд до 7 суток
S3_PRESIGN_EXPIRE_SECONDS=900

# JWT: сгенерируйте случайную строку, например python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS: JSON-массив origin'ов фронтенда
ALLOWED_ORIGINS=["http://localhost:3000"]

MAX_UPLOAD_BYTES=10485760
MAX_IMAGE_PIXELS=50000000
PHOTO_JPEG_QUALITY=90

# Пороги качества фото (настраиваются под реальные камеры)
QUALITY_MIN_WIDTH=640
QUALITY_MIN_HEIGHT=480
QUALITY_BLUR_THRESHOLD=60
QUALITY_MIN_BRIGHTNESS=40
QUALITY_MAX_BRIGHTNESS=215

# Frontend
FRONTEND_PORT=3000
